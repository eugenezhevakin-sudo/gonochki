; APEX GRID Track Lab | isolated public prototype | Godot 4.4.1
config_version=5

[application]
config/name="APEX GRID · Track Lab"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="Standalone 23-circuit geometry and drivable-proxy preview."
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.07, 0.14, 0.19, 1)

[physics]
common/physics_ticks_per_second=60
